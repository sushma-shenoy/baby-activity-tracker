rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function caregiverPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/caregivers/$(request.auth.uid);
    }

    function isCaregiver(userId) {
      return signedIn() && exists(caregiverPath(userId));
    }

    function isCaregiverForProfile(userId, profileId) {
      return isCaregiver(userId)
        && get(caregiverPath(userId)).data.profileId == profileId;
    }

    function hasValidInvite(inviteCode, ownerId) {
      return inviteCode is string
        && exists(
          /databases/$(database)/documents/caregiverInvites/$(inviteCode)
        )
        && get(
          /databases/$(database)/documents/caregiverInvites/$(inviteCode)
        ).data.ownerId == ownerId
        && get(
          /databases/$(database)/documents/caregiverInvites/$(inviteCode)
        ).data.expiresAt > request.time.toMillis();
    }

    function isOwnerManagedTrackerDocument(dataKey) {
      return dataKey == 'baby_profiles_v2';
    }

    function isOwnerManagedWrite() {
      return request.resource.data.key == 'baby_profiles_v2';
    }

    match /users/{userId}/trackerData/{dataKey} {
      allow read: if owns(userId);
      allow delete: if owns(userId);

      allow create, update: if owns(userId)
        && (
          (
            !isOwnerManagedTrackerDocument(dataKey) &&
            !isOwnerManagedWrite()
          ) || owns(userId)
        )
        && request.resource.data.keys().hasOnly([
          'key',
          'value',
          'updatedAt'
        ])
        && request.resource.data.key is string
        && request.resource.data.key.size() <= 300
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 900000;
    }

    match /users/{userId}/sharedProfiles/{profileId}/trackerData/{dataKey} {
      allow read: if owns(userId) || isCaregiverForProfile(userId, profileId);
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'key',
          'value',
          'updatedAt'
        ])
        && request.resource.data.key is string
        && request.resource.data.key.size() <= 300
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 900000;
      allow delete: if owns(userId);
    }

    match /users/{userId}/photos/{photoId} {
      allow read: if owns(userId) || (
        resource.data.profileId is string &&
        isCaregiverForProfile(userId, resource.data.profileId)
      );
      allow delete: if owns(userId);

      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'imageBytes',
          'contentType',
          'category',
          'profileId',
          'updatedAt'
        ])
        && request.resource.data.imageBytes is bytes
        && request.resource.data.imageBytes.size() <= 307200
        && request.resource.data.contentType == 'image/webp'
        && request.resource.data.category in ['diaper', 'profile']
        && request.resource.data.profileId is string;
    }

    match /users/{userId}/accountSettings/{settingId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId)
        && settingId == 'profile'
        && request.resource.data.caregiverOnly is bool
        && request.resource.data.keys().hasOnly([
          'caregiverOnly',
          'updatedAt'
        ]);
      allow delete: if owns(userId);
    }

    match /users/{userId}/deletionJobs/{profileId} {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.ownerId == userId
        && request.resource.data.profileId == profileId
        && request.resource.data.profileDeleted is bool
        && request.resource.data.photosDeleted is bool
        && request.resource.data.invitesDeleted is bool
        && request.resource.data.requestsDeleted is bool
        && request.resource.data.sharedDataDeleted is bool
        && request.resource.data.updatedAt is number
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'profileId',
          'profileDeleted',
          'photosDeleted',
          'invitesDeleted',
          'requestsDeleted',
          'sharedDataDeleted',
          'updatedAt'
        ]);
    }

    match /users/{ownerId}/changeRequests/{requestId} {
      allow read: if owns(ownerId) || (
        signedIn() && resource.data.caregiverId == request.auth.uid
      );
      allow delete: if owns(ownerId) || (
        signedIn() && resource.data.caregiverId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.caregiverId == request.auth.uid
        && isCaregiver(ownerId)
        && get(caregiverPath(ownerId)).data.role == 'editor'
        && (
          !('profileId' in get(caregiverPath(ownerId)).data) ||
          get(caregiverPath(ownerId)).data.profileId == request.resource.data.profileId
        )
        && request.resource.data.key is string
        && request.resource.data.key.size() <= 300
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 900000
        && request.resource.data.baseValue is string
        && request.resource.data.baseValue.size() <= 900000
        && request.resource.data.operation in ['set', 'remove']
        && request.resource.data.caregiverName is string
        && request.resource.data.profileId is string
        && request.resource.data.profileId.size() > 0
        && request.resource.data.changeGroupId is string
        && request.resource.data.changeGroupId.size() > 0
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly([
          'key',
          'value',
          'baseValue',
          'operation',
          'caregiverId',
          'caregiverName',
          'profileId',
          'changeGroupId',
          'createdAt'
        ]);
      allow update: if false;
    }

    match /caregiverInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if signedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.babyName is string
        && request.resource.data.profileId is string
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'ownerName',
          'babyName',
          'profileId',
          'createdAt',
          'expiresAt'
        ]);
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (
          resource.data.ownerId != request.auth.uid &&
          getAfter(
            /databases/$(database)/documents/users/$(resource.data.ownerId)/caregivers/$(request.auth.uid)
          ).data.inviteCode == inviteCode
        )
      );
    }

    match /users/{ownerId}/caregivers/{caregiverId} {
      allow read: if owns(ownerId) || (
        signedIn() && request.auth.uid == caregiverId
      );

      allow create: if signedIn()
        && request.auth.uid == caregiverId
        && request.resource.data.inviteCode is string
        && exists(
          /databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)
        )
        && get(
          /databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)
        ).data.ownerId == ownerId
        && get(
          /databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)
        ).data.expiresAt > request.time.toMillis()
        && request.resource.data.role == 'editor'
        && request.resource.data.profileId is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.joinedAt is number
        && request.resource.data.keys().hasOnly([
          'inviteCode',
          'displayName',
          'email',
          'role',
          'profileId',
          'joinedAt'
        ]);

      allow update: if (
        owns(ownerId)
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.profileId is string
        && request.resource.data.profileId.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'profileId'])
      ) || (
        signedIn()
        && request.auth.uid == caregiverId
        && hasValidInvite(request.resource.data.inviteCode, ownerId)
        && request.resource.data.role == 'editor'
        && request.resource.data.profileId is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.joinedAt is number
        && request.resource.data.keys().hasOnly([
          'inviteCode',
          'displayName',
          'email',
          'role',
          'profileId',
          'joinedAt'
        ])
      );
      allow delete: if owns(ownerId) || (
        signedIn() && request.auth.uid == caregiverId
      );
    }

    match /userFamilyLinks/{userId}/families/{ownerId} {
      allow read: if signedIn()
        && request.auth.uid == userId;
      allow delete: if signedIn() && (
        request.auth.uid == userId ||
        request.auth.uid == ownerId
      );
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.inviteCode is string
        && request.resource.data.ownerId == ownerId
        && request.resource.data.ownerName is string
        && request.resource.data.joinedAt is number
        && (
          (
            exists(
              /databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)
            )
            && get(
              /databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)
            ).data.ownerId == ownerId
            && get(
              /databases/$(database)/documents/caregiverInvites/$(request.resource.data.inviteCode)
            ).data.expiresAt > request.time.toMillis()
          )
          || exists(
            /databases/$(database)/documents/users/$(ownerId)/caregivers/$(userId)
          )
        )
        && request.resource.data.keys().hasOnly([
          'inviteCode',
          'ownerId',
          'ownerName',
          'joinedAt'
        ]);
      allow update: if (
        signedIn()
        && request.auth.uid == userId
        && hasValidInvite(request.resource.data.inviteCode, ownerId)
        && request.resource.data.ownerId == ownerId
        && request.resource.data.ownerName is string
        && request.resource.data.joinedAt is number
        && request.resource.data.keys().hasOnly([
          'inviteCode',
          'ownerId',
          'ownerName',
          'joinedAt'
        ])
      ) || (
        signedIn()
        && request.auth.uid == ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ownerName'])
        && request.resource.data.ownerName is string
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
